<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<c:set var="curUri" value="${not empty requestScope['javax.servlet.forward.request_uri'] ? requestScope['javax.servlet.forward.request_uri'] : pageContext.request.requestURI}"/>
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>충남 건설입찰 통계</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="/css/app.css" rel="stylesheet">
</head>
<body>
<header class="top-header"><div class="inner">
  <button type="button" class="nav-toggle" aria-label="메뉴" onclick="document.body.classList.toggle('nav-open')"><span></span><span></span><span></span></button>
  <a class="brand" href="/">충남<span>입찰</span>통계<small>CN Bid Stats · 충남 7개 시·군 공사입찰</small></a>
  <form class="quick-search" method="get" action="/search">
    <input type="hidden" name="run" value="1">
    <input type="text" name="keyword" value="${form.keyword}" placeholder="공고명 키워드를 입력하세요 (예: 도로, 포장)">
    <button type="submit">검색</button>
  </form>
  <nav class="top-nav"><a href="/">홈</a><a href="/search">검색</a><a href="/settings">설정</a><a href="/stats">통계</a>
    <c:choose>
      <c:when test="${not empty pageContext.request.userPrincipal}">
        <a href="/admin" class="admin-link">${pageContext.request.userPrincipal.name}님 · 관리자</a>
        <form method="post" action="/logout" class="d-inline"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button type="submit" class="link-btn">로그아웃</button></form>
      </c:when>
      <c:otherwise><a href="/login" class="admin-link">로그인</a></c:otherwise>
    </c:choose></nav>
</div></header>
<div class="sub-nav"><div class="inner">
  <a href="/" class="${curUri == '/' ? 'on' : ''}">홈</a>
  <a href="/search" class="${fn:startsWith(curUri,'/search') ? 'on' : ''}">입찰공고</a>
  <a href="/stats" class="${fn:startsWith(curUri,'/stats') || fn:startsWith(curUri,'/region') ? 'on' : ''}">입찰통계</a>
  <a href="/settings" class="${fn:startsWith(curUri,'/settings') ? 'on' : ''}">검색조건</a>
  <a href="/admin" class="${fn:startsWith(curUri,'/admin') ? 'on' : ''}">관리자</a>
</div></div>
<c:if test="${mockMode}">
  <div class="mock-banner">현재 <b>데모(Mock) 모드</b>입니다. 나라장터 API 키(G2B_SERVICE_KEY)를 설정하면 실제 데이터를 조회합니다.</div>
</c:if>
<div class="nav-backdrop" onclick="document.body.classList.remove('nav-open')"></div>
<div class="layout">
<%@ include file="sidebar.jspf" %>
<main class="main">
