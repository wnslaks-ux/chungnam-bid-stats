</main>
</div>
<footer class="site-footer">
  <div class="bar"><div class="inner">
    <a href="/"><%= "\uD648" %></a><span>|</span><a href="/search"><%= "\uAC80\uC0C9" %></a><span>|</span><a href="/settings"><%= "\uC124\uC815" %></a><span>|</span><a href="/stats"><%= "\uD1B5\uACC4" %></a>
  </div></div>
  <div class="info"><%= "\uB370\uC774\uD130\u0020\uCD9C\uCC98\u003A\u0020\uC870\uB2EC\uCCAD\u0020\uB098\uB77C\uC7A5\uD130\u0020\uC785\uCC30\uACF5\uACE0\uC815\uBCF4\uC11C\uBE44\uC2A4\u0020\u0028\uACF5\uACF5\uB370\uC774\uD130\uD3EC\uD138\u0029" %><br>&copy; CN Bid Stats</div>
</footer>
<script>
(function(){
  function scrollToBidList(){
    var el = document.getElementById('bid-list') || document.getElementById('bid-list-head') || document.getElementById('bid-list-panel');
    if(!el) return;
    var q = new URLSearchParams(location.search);
    var page = parseInt(q.get('page')||'1',10);
    if(location.hash === '#bid-list' || page > 1){
      setTimeout(function(){ el.scrollIntoView({behavior:'instant' in document.documentElement.style ? 'instant' : 'auto', block:'start'}); }, 50);
    }
  }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', scrollToBidList);
  else scrollToBidList();
})();
</script>
<div id="loading-overlay" class="loading-overlay" aria-hidden="true" role="alert" aria-live="assertive">
  <div class="loading-box">
    <div class="loading-spinner"></div>
    <div class="loading-text">나라장터 조회 중…<br><small>잠시만 기다려 주세요.</small></div>
    <div class="loading-bar"><span></span></div>
  </div>
</div>
<script>
window.showLoading=function(msg){var o=document.getElementById('loading-overlay');if(!o)return;
  var t=o.querySelector('.loading-text');if(t)t.innerHTML=msg||'나라장터 조회 중…<br><small>잠시만 기다려 주세요.</small>';
  o.classList.add('show');o.setAttribute('aria-hidden','false');};
window.hideLoading=function(){var o=document.getElementById('loading-overlay');if(o){o.classList.remove('show');o.setAttribute('aria-hidden','true');}
  var b=document.getElementById('btn-search');if(b){b.disabled=false;b.textContent='검색';}var s=document.getElementById('search-busy');if(s)s.style.display='none';};
window.addEventListener('pageshow',function(e){if(e.persisted)hideLoading();});
var NAV_MSG='페이지 불러오는 중…<br><small>잠시만 기다려 주세요.</small>';
document.addEventListener('click',function(e){
  if(e.defaultPrevented||e.button!==0||e.ctrlKey||e.metaKey||e.shiftKey||e.altKey)return;
  var a=e.target.closest&&e.target.closest('a[href]');if(!a)return;
  var h=a.getAttribute('href');if(!h||h.charAt(0)==='#'||/^(javascript:|mailto:|tel:)/i.test(h))return;
  if(a.target&&a.target!=='_self')return; if(a.hasAttribute('download'))return;
  var u;try{u=new URL(a.href,location.href);}catch(x){return;}
  if(u.origin!==location.origin)return;
  if(u.pathname===location.pathname&&u.search===location.search&&u.hash)return;
  showLoading(/[?&]run=1/.test(u.search)?null:NAV_MSG);});
document.addEventListener('submit',function(e){var f=e.target;
  setTimeout(function(){if(e.defaultPrevented||(f.target&&f.target!=='_self'))return;
    if(f.classList.contains('search-box'))return; /* searchForm handles its own */
    showLoading(f.classList.contains('quick-search')?null:'처리 중…<br><small>잠시만 기다려 주세요.</small>');},0);});
</script>
</body>
</html>
